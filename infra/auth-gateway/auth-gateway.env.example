# Server-only — /etc/picom/auth-gateway.env
# Browser never sees these URLs; Steam OpenID uses auth.picom.gg only.

SUPABASE_URL=https://ufmtvqtsklqsmqxefbbs.supabase.co
SUPABASE_ANON_KEY=
ACCOUNT_CENTER_URL=https://account.picom.gg
AUTH_GATEWAY_PORT=4180
# In Docker set AUTH_GATEWAY_BIND=0.0.0.0 and publish 127.0.0.1:4180:4180 only.
# AUTH_GATEWAY_BIND=127.0.0.1
# Leave unset in production (Host must be auth.picom.gg via nginx).
# AUTH_GATEWAY_ALLOW_ANY_HOST=false
