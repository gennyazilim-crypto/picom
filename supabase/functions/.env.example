# Picom Supabase Edge Function local environment
# Copy to a local function-only .env file when using Supabase CLI.
# Do not commit real secrets.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# Server/Edge Function only. Supabase normally injects this in deployed functions.
# Never rename with a VITE_ prefix or pass it to the Electron renderer.
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit server-side credentials for supabase/functions/livekit-token only.
# Never expose these as VITE_ variables or renderer/preload values.
LIVEKIT_URL=https://your-livekit-host.example
LIVEKIT_API_KEY=replace-with-local-livekit-api-key
LIVEKIT_API_SECRET=replace-with-local-livekit-api-secret
PICOM_ALLOWED_ORIGINS=http://127.0.0.1:5173

# Internal account-deletion worker. Keep disabled unless operations/legal approve it.
ACCOUNT_DELETION_FINALIZATION_ENABLED=false
ACCOUNT_DELETION_WORKER_SECRET=

# Email API secrets. The Supabase Edge Function queues validated intents only;
# SMTP credentials belong on the Ubuntu worker and must never use a VITE_ prefix.
EMAIL_UNSUBSCRIBE_SECRET=replace-with-at-least-32-random-bytes
EMAIL_RATE_LIMIT_SALT=replace-with-at-least-32-random-bytes
TURNSTILE_SECRET_KEY=

# PICOM Verified billing (Edge Functions only — never VITE_ / renderer).
# Leave unset to fail closed (checkout/portal/webhook return NOT_CONFIGURED).
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=
STRIPE_PICOM_VERIFIED_MONTHLY_PRICE_ID=
STRIPE_PICOM_VERIFIED_YEARLY_PRICE_ID=
PICOM_ACCOUNT_CENTER_URL=https://account.picom.gg
PICOM_CHECKOUT_SUCCESS_URL=
PICOM_CHECKOUT_CANCEL_URL=
PICOM_APP_URL=https://app.picom.gg

# Business verification Edge Functions only — never expose in VITE_ variables.
BUSINESS_DOCUMENT_BUCKET=business-verification-documents
BUSINESS_DOCUMENT_MAX_BYTES=10485760
BUSINESS_DOCUMENT_SIGNED_URL_TTL_SECONDS=300
BUSINESS_DOMAIN_VERIFICATION_ENABLED=false
BUSINESS_DOMAIN_FETCH_TIMEOUT_MS=3000
BUSINESS_DOMAIN_MAX_REDIRECTS=0
BUSINESS_INVITATION_TTL_HOURS=168
BUSINESS_PROFILE_ASSET_BUCKET=business-profile-assets
BUSINESS_PRODUCT_MEDIA_BUCKET=business-product-media
BUSINESS_PRODUCT_MEDIA_MAX_BYTES=10485760
BUSINESS_PRODUCT_VIDEO_MAX_BYTES=52428800
BUSINESS_PRODUCT_MAX_TAGS_PER_POST=10
BUSINESS_EXTERNAL_LINK_SCAN_ENABLED=false
BUSINESS_POST_SCHEDULER_ENABLED=false
BUSINESS_ANALYTICS_MINIMUM_COHORT=5
MALWARE_SCANNER_PROVIDER=

# Advertising delivery / funding (Edge + workers only — never VITE_).
# Missing AD_DELIVERY_SIGNING_SECRET / AD_CLICK_SIGNING_SECRET fail closed.
ADVERTISING_ENABLED=false
ADVERTISING_GLOBAL_KILL_SWITCH=true
AD_DELIVERY_SIGNING_SECRET=
AD_CLICK_SIGNING_SECRET=
AD_DELIVERY_TOKEN_TTL_SECONDS=300
AD_CLICK_TOKEN_TTL_SECONDS=300
AD_IMPRESSION_MIN_VISIBILITY_RATIO=0.5
AD_IMPRESSION_MIN_VISIBLE_MS=1000
AD_DEFAULT_FREQUENCY_CAP_COUNT=3
AD_DEFAULT_FREQUENCY_CAP_WINDOW_SECONDS=86400
AD_MINIMUM_AUDIENCE_SIZE=1000
AD_MAX_CAMPAIGN_BUDGET_MINOR=
AD_MAX_DAILY_BUDGET_MINOR=
AD_MAX_CREATIVES_PER_AD_SET=20
AD_MAX_AD_SETS_PER_CAMPAIGN=50
AD_CONVERSION_SIGNING_SECRET=
AD_CONVERSION_DEFAULT_WINDOW_SECONDS=604800
AD_FRAUD_PROVIDER=
AD_FRAUD_API_URL=
AD_FRAUD_API_KEY=
AD_URL_REPUTATION_PROVIDER=
AD_URL_REPUTATION_API_KEY=
AD_SCHEDULER_ENABLED=false
AD_RECONCILIATION_ENABLED=false
AD_RECONCILIATION_HOLD_DAYS=7
AD_ANALYTICS_MINIMUM_COHORT=5
AD_PAYMENT_PROVIDER=
AD_PAYMENT_WEBHOOK_SECRET=

# Partner payout provider (Edge only — never VITE_). Missing secrets fail closed.
PAYOUT_PROVIDER=stripe_connect
PAYOUT_PROVIDER_SECRET_KEY=
PAYOUT_PROVIDER_WEBHOOK_SECRET=
PAYOUT_ONBOARDING_RETURN_URL=
PAYOUT_ONBOARDING_REFRESH_URL=
PAYOUT_DEFAULT_CURRENCY=USD
PAYOUT_BATCH_PROCESSING_ENABLED=false
TAX_PROVIDER=
TAX_PROVIDER_API_KEY=
TAX_DOCUMENT_BUCKET=
