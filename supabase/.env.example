# Supabase Edge Function secrets for local/staging setup.
# Copy to a local ignored file or set with `supabase secrets set`.
# Never expose these values through VITE_ variables or commit real values.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# PICOM Verified Individual via iyzico Link. Set real values only with
# `supabase secrets set`; never use VITE_ variables or commit credentials.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_API_BASE_URL=https://api.iyzipay.com
IYZICO_LINK_PRODUCT_IMAGE_BASE64=
IYZICO_VERIFIED_INTENT_TTL_MINUTES=
IYZICO_WEBHOOK_SIGNATURE_ENABLED=false

# Optional health placeholders; do not include credentials.
PICOM_HEALTH_DATABASE_STATUS=ok_placeholder
PICOM_HEALTH_REDIS_STATUS=not_required
PICOM_HEALTH_STORAGE_STATUS=ok_placeholder
PICOM_HEALTH_REALTIME_STATUS=ok_placeholder
